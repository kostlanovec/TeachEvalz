@page "/"
@using Grpc.Net.Client;
@using Grpc.Net.ClientFactory;
@using Grpc.Net.Client.Web;
@using Microsoft.AspNetCore.Components;
@using ClientApp.Services.Interfaces;
@inject IServerCallService _serverCallService;
@inject IAuthenticationService _authenticationService;

<PageTitle>Index</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

<SurveyPrompt Title="How is Blazor working for you?" />

@code {
    private async Task Greet()
    {
        var channel = await _serverCallService.CreateChannel("https://localhost:7130");
        var client = new Greeter.GreeterClient(channel);
        var response = await client.SayHelloAsync(new HelloRequest { Name = "World" });
        Console.WriteLine(response.Message);

    }
    protected override async Task OnInitializedAsync()
    {
        await Greet();
        var response = await _authenticationService.RegisterPerson(new RegisterPersonRequest
        {
            FirstName = "Jan",
            LastName = "Sebastian",
            Nickname = "Kostik",
            Password = "banan",
            PrimaryEmail = "kostik@kostlanovec.cz",
            PrimaryLanguageId = 727
        }
        );
        Console.WriteLine(response.PersonId);
    }
}